# Ejemplo de variables nuevas. Copiar las necesarias al .env (no versionado).

# --- MinIO: espejo de los carnés para GADSO (Drive sigue siendo la base) ---
# 0 = desactivado: el bot se comporta exactamente como antes.
MINIO_ENABLED=0
MINIO_ENDPOINT=s3.liderman.net.pe
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mga-gadso
MINIO_USE_SSL=1
MINIO_PREFIX=sucamec/carnets

# --- Ceses: Excel con los mismos campos que el padrón (DNI + negocio/razón social) ---
# Vacío = se toma el más reciente data/entrada/ceses*.xlsx
CARNET_CESES_EXCEL=
